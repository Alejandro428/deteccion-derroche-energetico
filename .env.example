# Postgres (datos historicos de los sensores)
DB_USER=postgres
DB_PASSWORD=pon_aqui_tu_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres

# Logging del ETL (opcional)
ETL_LOG_TARGET=sqlite
ETL_LOG_SQLITE_BUFFER_PATH=data/lake/logs/etl_log_buffer.sqlite

# Grafana admin (solo si usas docker-compose completo)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# MySQL para logs persistentes del ETL (opcional, solo si usas docker-compose completo)
MYSQL_LOG_USER=etl_logger
MYSQL_LOG_PASSWORD=pon_aqui_otra_password
MYSQL_LOG_HOST=127.0.0.1
MYSQL_LOG_PORT=3306
MYSQL_LOG_DB=etl_logs
